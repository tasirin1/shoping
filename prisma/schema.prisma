generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  auditLogs AuditLog[]
  carts     Cart[]
  sessions  Session[]
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  banner      String?
  thumbnail   String?
  category    String?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nominals Nominal[]
  orders   Order[]
  carts    Cart[]
}

model Nominal {
  id            String   @id @default(cuid())
  gameId        String
  name          String
  amount        Int
  price         Float
  originalPrice Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders Order[]
  carts  Cart[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  type      String
  icon      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  carts  Cart[]
}

model Promo {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  discount     Float
  discountType String   @default("PERCENTAGE")
  minPurchase  Float?
  maxDiscount  Float?
  maxUses      Int?
  usedCount    Int      @default(0)
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  link      String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  invoice         String   @unique
  userId          String
  gameId          String
  nominalId       String
  paymentMethodId String?
  playerId        String
  playerNickname  String?
  amount          Float
  fee             Float    @default(0)
  total           Float
  status          String   @default("PENDING")
  paymentProof    String?
  promoCode       String?
  discountAmount  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  user          User           @relation(fields: [userId], references: [id])
  game          Game           @relation(fields: [gameId], references: [id])
  nominal       Nominal        @relation(fields: [nominalId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([userId])
  @@index([invoice])
  @@index([status])
}

model Cart {
  id              String   @id @default(cuid())
  userId          String
  gameId          String
  nominalId       String
  paymentMethodId String?
  playerId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  nominal       Nominal        @relation(fields: [nominalId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}
