// Shoping - Prisma Schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Auth
// ============================================================
model User {
  id        String   @id @default(uuid())
  email     String?
  username  String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  avatar    String?
  phone     String?
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  orders   Order[]
  logs     AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Game Catalog
// ============================================================
model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  icon      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]
}

model Provider {
  id         String   @id @default(uuid())
  name       String
  baseUrl    String?
  apiKey     String?
  apiSecret  String?
  merchantId String?
  signature  String?
  active     Boolean  @default(true)
  sandbox    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  games Game[]
}

model Game {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  icon         String?
  banner       String?
  thumbnail    String?
  categoryId   String?
  categoryName String?
  popular      Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  providerId   String?
  promoLabel   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryRel Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  provider    Provider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  products    Product[]
  orders      Order[]
}

model Product {
  id            String   @id @default(uuid())
  gameId        String
  name          String
  amount        Int
  price         Int
  originalPrice Int?
  costPrice     Int?
  profit        Int?
  stock         Int      @default(-1)
  active        Boolean  @default(true)
  productCode   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders Order[]
}

// ============================================================
// Orders & Payments
// ============================================================
model PaymentMethod {
  id            String   @id @default(uuid())
  name          String
  type          String
  icon          String?
  accountNumber String?
  accountName   String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String    @id @default(uuid())
  invoice         String    @unique
  userId          String
  gameId          String
  nominalId       String
  paymentMethodId String?
  playerId        String
  playerNickname  String?
  amount          Int
  fee             Int       @default(0)
  total           Int
  status          String    @default("PENDING")
  paymentProof    String?
  promoCode       String?
  discountAmount  Int       @default(0)
  note            String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  game          Game           @relation(fields: [gameId], references: [id])
  nominal       Product        @relation(fields: [nominalId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
}

// ============================================================
// Promotions
// ============================================================
model Promo {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  discount     Int
  discountType String   @default("PERCENTAGE")
  minPurchase  Int?
  maxDiscount  Int?
  maxUses      Int?
  usedCount    Int      @default(0)
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// Banners & Settings
// ============================================================
model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  image     String?
  link      String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Audit Logs
// ============================================================
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
