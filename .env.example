# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
# Required — must be set in production (Koyeb, Railway, etc.)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/shoping
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoping?schema=public"

# Session secret (change in production!)
SESSION_SECRET="change-this-to-a-secure-random-string-at-least-32-characters"

# CAPTCHA (placeholder - replace with your reCAPTCHA keys for production)
NEXT_PUBLIC_CAPTCHA_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"

# Run seed on startup (set to "true" for first deployment only)
RUN_SEED="false"

# Upload size limit (default: 5MB)
MAX_UPLOAD_SIZE="5242880"

# Default Admin Credentials (seeded):
# Username: admin / Password: admin123

# Default User Credentials (seeded):
# Username: demo / Password: demo123
